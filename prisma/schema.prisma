generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SYSTEM_ADMIN
  HOD
  LECTURER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
  WITHDRAWN
}

enum Semester {
  FIRST
  SECOND
}

enum CourseType {
  COMPULSORY
  ELECTIVE
}

enum AdviserAssignmentStatus {
  OFFERED
  ACTIVE
  DECLINED
  ENDED
}

enum ResultStatus {
  PENDING
  POSTED
  CORRECTED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UploadFileStatus {
  VALID
  UNMATCHED_COURSE
  PROCESSING
  FAILED
  COMPLETED
}

enum UploadRowStatus {
  VALID
  UNMATCHED_STUDENT
  DUPLICATE
  INVALID_SCORE
  IMPORTED
}

enum GraduationStatus {
  PENDING
  RUNNING
  COMPLETED
}

enum StudentCreationMethod {
  MANUAL
  EXCEL_IMPORT
}

enum StudentSeedBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StudentSeedRowStatus {
  VALID
  DUPLICATE_MATRIC
  INVALID_DATA
  IMPORTED
  FAILED
}

enum UserSeedBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UserSeedRowStatus {
  VALID
  DUPLICATE_EMAIL
  INVALID_DATA
  IMPORTED
  FAILED
}

// ============================================================================
// USER
// ============================================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Courses (HOD)
  coursesCreated Course[] @relation("CourseCreatedBy")
  coursesUpdated Course[] @relation("CourseUpdatedBy")

  // Students (Lecturer/Adviser)
  studentsCreated Student[] @relation("StudentCreatedBy")

  // Adviser assignments
  adviserAssignments  AdviserAssignment[] @relation("Lecturer")
  assignmentsAssigned AdviserAssignment[] @relation("AssignedBy")

  // Result uploads
  uploadBatches UploadBatch[] @relation("UploadedBy")

  // Corrections
  correctionsRequested CorrectionRequest[] @relation("CorrectionRequester")
  correctionsApproved  CorrectionRequest[] @relation("CorrectionApprover")

  // Override tokens
  tokensGenerated OverrideToken[] @relation("TokenGeneratedBy")
  tokensIssuedTo  OverrideToken[] @relation("TokenIssuedTo")

  // Change log
  resultChanges ResultChangeLog[] @relation("ChangedBy")

  // Submission windows
  windowsOpened ResultSubmissionWindow[] @relation("OpenedBy")

  // Graduation
  graduationRunsTriggered GraduationRun[] @relation("TriggeredBy")

  // Student seeding
  studentSeedBatches StudentSeedBatch[] @relation("StudentSeedUploadedBy")

  // Lecturer/user seeding
  userSeedBatchesUploaded UserSeedBatch[] @relation("UserSeedUploadedBy")
  createdViaSeedRow       UserSeedRow?    @relation("UserFromSeedRow")

  // HOD assignment history
  hodAssignmentsHeld  HodAssignment[] @relation("HodUser")
  hodAssignmentsGiven HodAssignment[] @relation("HodAssignedBy")
}

// ============================================================================
// HOD ASSIGNMENT  (audit trail; User.role is still the source of truth
// for permissions, this table just tracks who held the seat and when)
// ============================================================================

model HodAssignment {
  id String @id @default(cuid())

  userId String
  user   User   @relation("HodUser", fields: [userId], references: [id])

  assignedById String
  assignedBy   User   @relation("HodAssignedBy", fields: [assignedById], references: [id])

  startDate DateTime  @default(now())
  endDate   DateTime? // null = currently active HOD

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([endDate])
}

// ============================================================================
// COURSE  (HOD-owned; single-department scope; carries curriculum attributes)
// ============================================================================

model Course {
  id          String     @id @default(cuid())
  code        String     @unique
  title       String
  creditUnits Int
  level       Int
  semester    Semester
  courseType  CourseType @default(COMPULSORY)
  isActive    Boolean    @default(true)

  createdById String
  createdBy   User    @relation("CourseCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("CourseUpdatedBy", fields: [updatedById], references: [id])

  results           StudentResult[]
  uploadFiles       UploadFile[]
  submissionWindows ResultSubmissionWindow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, semester])
}

// ============================================================================
// STUDENT  (record only — no auth, students don't log in)
// ============================================================================

model Student {
  id String @id @default(cuid())

  matricNumber String        @unique
  fullName     String
  entrySession String
  currentLevel Int
  status       StudentStatus @default(ACTIVE)

  creationMethod StudentCreationMethod @default(MANUAL)
  seedRowId      String?               @unique
  seedRow        StudentSeedRow?       @relation(fields: [seedRowId], references: [id])

  createdById String
  createdBy   User   @relation("StudentCreatedBy", fields: [createdById], references: [id])

  results          StudentResult[]
  uploadRows       UploadRow[]
  eligibilityItems EligibilityRunItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrySession])
  @@index([status])
}

// ============================================================================
// STUDENT SEEDING  (Excel import per session; mirrors UploadBatch/File/Row)
// ============================================================================

model StudentSeedBatch {
  id String @id @default(cuid())

  entrySession String

  uploadedById String
  uploadedBy   User   @relation("StudentSeedUploadedBy", fields: [uploadedById], references: [id])

  status StudentSeedBatchStatus @default(PENDING)

  rows StudentSeedRow[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([entrySession])
}

model StudentSeedRow {
  id String @id @default(cuid())

  batchId String
  batch   StudentSeedBatch @relation(fields: [batchId], references: [id])

  matricNumberRaw String
  fullNameRaw     String
  levelRaw        Int?

  status       StudentSeedRowStatus @default(VALID)
  errorMessage String?

  student Student?

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([status])
}

// ============================================================================
// USER SEEDING  (bulk lecturer import — these accounts DO log in,
// so an 8-digit password is generated + hashed per row)
// ============================================================================

model UserSeedBatch {
  id String @id @default(cuid())

  role UserRole @default(LECTURER)

  uploadedById String
  uploadedBy   User   @relation("UserSeedUploadedBy", fields: [uploadedById], references: [id])

  status UserSeedBatchStatus @default(PENDING)

  rows UserSeedRow[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model UserSeedRow {
  id String @id @default(cuid())

  batchId String
  batch   UserSeedBatch @relation(fields: [batchId], references: [id])

  nameRaw  String
  emailRaw String

  status       UserSeedRowStatus @default(VALID)
  errorMessage String?

  generatedPassword String? // shown once at seed time; clear after display/export

  userId String? @unique
  user   User?   @relation("UserFromSeedRow", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([status])
}

// ============================================================================
// ADVISER ASSIGNMENT
// ============================================================================

model AdviserAssignment {
  id String @id @default(cuid())

  lecturerId String
  lecturer   User   @relation("Lecturer", fields: [lecturerId], references: [id])

  assignedById String
  assignedBy   User   @relation("AssignedBy", fields: [assignedById], references: [id])

  entrySession String

  status AdviserAssignmentStatus @default(OFFERED)

  offeredAt   DateTime  @default(now())
  respondedAt DateTime?

  startDate       DateTime?
  expectedEndDate DateTime?
  endDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lecturerId, status])
  @@index([entrySession])
}

// ============================================================================
// STUDENT RESULT
// ============================================================================

model StudentResult {
  id String @id @default(cuid())

  studentId       String
  student         Student @relation(fields: [studentId], references: [id])
  courseId        String
  course          Course  @relation(fields: [courseId], references: [id])
  academicSession String

  score         Float?
  grade         String?
  gradePoint    Float?
  attemptNumber Int          @default(1)
  status        ResultStatus @default(PENDING)

  currentVersionOfId String?        @unique
  currentVersionOf   StudentResult? @relation("ResultVersioning", fields: [currentVersionOfId], references: [id])
  previousVersion    StudentResult? @relation("ResultVersioning")

  uploadRows         UploadRow[]
  correctionRequests CorrectionRequest[]
  changeLogs         ResultChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId, academicSession, attemptNumber])
  @@index([courseId, academicSession])
  @@index([status])
}

// ============================================================================
// CORRECTION REQUEST
// ============================================================================

model CorrectionRequest {
  id String @id @default(cuid())

  studentResultId String
  studentResult   StudentResult @relation(fields: [studentResultId], references: [id])

  requestedById String
  requestedBy   User   @relation("CorrectionRequester", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("CorrectionApprover", fields: [approvedById], references: [id])

  overrideTokenId String?
  overrideToken   OverrideToken? @relation(fields: [overrideTokenId], references: [id])

  oldScore Float
  newScore Float
  reason   String

  status CorrectionStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?

  @@index([studentResultId])
  @@index([status])
}

// ============================================================================
// OVERRIDE TOKEN
// ============================================================================

model OverrideToken {
  id String @id @default(cuid())

  token String @unique

  generatedById String
  generatedBy   User   @relation("TokenGeneratedBy", fields: [generatedById], references: [id])

  issuedToId String?
  issuedTo   User?   @relation("TokenIssuedTo", fields: [issuedToId], references: [id])

  used      Boolean  @default(false)
  expiresAt DateTime

  correctionRequests CorrectionRequest[]

  createdAt DateTime @default(now())
}

// ============================================================================
// RESULT CHANGE LOG
// ============================================================================

model ResultChangeLog {
  id String @id @default(cuid())

  studentResultId String
  studentResult   StudentResult @relation(fields: [studentResultId], references: [id])

  changedById String
  changedBy   User   @relation("ChangedBy", fields: [changedById], references: [id])

  oldScore Float?
  newScore Float?
  reason   String?

  changedAt DateTime @default(now())

  @@index([studentResultId])
}

// ============================================================================
// RESULT SUBMISSION WINDOW
// ============================================================================

model ResultSubmissionWindow {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  academicSession String
  semester        Semester

  openedById String
  openedBy   User   @relation("OpenedBy", fields: [openedById], references: [id])

  opensAt  DateTime
  closesAt DateTime

  createdAt DateTime @default(now())

  @@unique([courseId, academicSession, semester])
}

// ============================================================================
// RESULT UPLOAD PIPELINE
// ============================================================================

model UploadBatch {
  id String @id @default(cuid())

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  status UploadBatchStatus @default(PENDING)

  files UploadFile[]

  uploadedAt DateTime @default(now())
}

model UploadFile {
  id String @id @default(cuid())

  uploadBatchId String
  uploadBatch   UploadBatch @relation(fields: [uploadBatchId], references: [id])

  fileName           String
  courseCodeRaw      String
  academicSessionRaw String
  semesterRaw        String

  matchedCourseId String?
  matchedCourse   Course? @relation(fields: [matchedCourseId], references: [id])

  status       UploadFileStatus @default(VALID)
  errorMessage String?

  rows UploadRow[]

  createdAt DateTime @default(now())

  @@index([uploadBatchId])
  @@index([matchedCourseId])
  @@index([status])
}

model UploadRow {
  id String @id @default(cuid())

  uploadFileId String
  uploadFile   UploadFile @relation(fields: [uploadFileId], references: [id])

  matricNumberRaw String
  score           Float?

  matchedStudentId String?
  matchedStudent   Student? @relation(fields: [matchedStudentId], references: [id])

  studentResultId String?
  studentResult   StudentResult? @relation(fields: [studentResultId], references: [id])

  status       UploadRowStatus @default(VALID)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([uploadFileId])
  @@index([matchedStudentId])
  @@index([status])
}

// ============================================================================
// GRADUATION
// ============================================================================

model GraduationRun {
  id String @id @default(cuid())

  academicSession String

  status      GraduationStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?

  triggeredById String
  triggeredBy   User   @relation("TriggeredBy", fields: [triggeredById], references: [id])

  items EligibilityRunItem[]

  createdAt DateTime @default(now())

  @@index([academicSession])
}

model EligibilityRunItem {
  id String @id @default(cuid())

  graduationRunId String
  graduationRun   GraduationRun @relation(fields: [graduationRunId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  cgpa     Float
  eligible Boolean
  remarks  Json?

  @@unique([graduationRunId, studentId])
  @@index([eligible])
}
